# Enter credentials locally in .env.local. This template contains no credentials.
APP_ORIGIN=http://127.0.0.1:4191
# Hosted runtime: Supabase Postgres session-pooler URL, private storage and stable vault key.
DATABASE_URL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Generate 32 random bytes, encoded as base64. Preserve securely across deployments.
VAULT_KEY_BASE64=
CRON_SECRET=
# Sandbox first. Price IDs and secret key must belong to the same Stripe account/mode.
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
STRIPE_STARTER_PRICE_ID=
STRIPE_CREATOR_PRICE_ID=
STRIPE_STUDIO_PRICE_ID=
STRIPE_PORTAL_CONFIG_ID=
# Customer BYOK keys are connected through Account & keys, never copied here as a fallback.
COMFY_GENERATION_ENABLED=false
COMFY_MAX_CONCURRENT_JOBS=1
PLATFORM_GENERATION_ENABLED=false
HF_PLATFORM_CREDENTIALS=
PLATFORM_MONTHLY_CAP_CENTS=0
PLATFORM_MAX_CENTS_PER_SECOND=
PLATFORM_RATE_VALID_UNTIL=
# Optional standalone operator examples; not customer credentials.
HF_CREDENTIALS=
COMFY_API_KEY=
